{
  // Deploys the static Vite build (./dist) to Cloudflare as a Static-Assets
  // Worker. `npx wrangler deploy` reads this. There is no server code — just
  // static files — and `single-page-application` serves index.html for any
  // path that isn't a real file.
  "name": "lightroute",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
